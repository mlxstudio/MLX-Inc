{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "MLX Ink",
    "version":  "0.1.1",
    "identifier":  "com.mlxink.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "MLX Ink",
                                    "width":  1360,
                                    "height":  860,
                                    "minWidth":  560,
                                    "minHeight":  420,
                                    "center":  true,
                                    "dragDropEnabled":  false,
                                    "useHttpsScheme":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob:; font-src \u0027self\u0027 data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027none\u0027",
                                 "devCsp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob:; font-src \u0027self\u0027 data:; connect-src ipc: http://ipc.localhost https://ipc.localhost ws://localhost:1420; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027none\u0027",
                                 "dangerousDisableAssetCspModification":  [
                                                                              "script-src",
                                                                              "style-src"
                                                                          ]
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "shortDescription":  "MLX Ink",
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          },
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "requireSignedVersion":  true,
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMThEQjhGNkUwQUIxMTUKUldRVnNRcHVqOXNZaTEwZEwxcGt5b1B6Qnl3SEpFanVsV1JsMGtwaWo0dVorY2ppREtDSWhRRUgK",
                                    "endpoints":  [
                                                      "https://github.com/mlxstudio/MLX-Inc/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}
